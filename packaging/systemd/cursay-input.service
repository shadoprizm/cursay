[Unit]
Description=Cursay private keyboard-only input device
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/opt/cursay/vendor/ydotool/usr/bin/ydotoold --mouse-off --socket-path=%t/cursay-ydotool.sock --socket-perm=0600
Restart=on-failure
RestartSec=1
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
